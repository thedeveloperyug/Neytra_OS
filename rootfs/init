#!/bin/sh

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

# Route boot events through the real Logger (system/logger/) instead of plain
# echo — see scripts/build_system.sh for how neytra-log gets into rootfs/.
export NEYTRA_LOG_FILE=/var/log/neytra.log
LOG=/usr/bin/neytra-log
[ -x "$LOG" ] || LOG=:
$LOG info init "mounted proc, sysfs, devtmpfs"

printf '\n'
printf '\033[1;36m%s\033[0m\n' \
  ' _   _ ________     _________ _____               ____   _____ ' \
  '| \ | |  ____\ \   / /__   __|  __ \     /\      / __ \ / ____|' \
  '|  \| | |__   \ \_/ /   | |  | |__) |   /  \    | |  | | (___  ' \
  '| . ` |  __|   \   /    | |  |  _  /   / /\ \   | |  | |\___ \ ' \
  '| |\  | |____   | |     | |  | | \ \  / ____ \  | |__| |____) |' \
  '|_| \_|______|  |_|     |_|  |_|  \_\/_/    \_\  \____/|_____/ '
  printf '\n'
printf '\033[1;33m              >> Neytra OS 2026 <<\033[0m\n'
printf '\033[1;35m              Author: @thedeveloperyug\033[0m\n'
printf '\n'

# Handle shutdown signals
trap "poweroff -f" SIGTERM SIGPWR
$LOG info init "shutdown handler registered (SIGTERM/SIGPWR -> poweroff -f)"

# Bring up loopback + any real interface and DHCP it, in the background so a
# missing cable/DHCP server never delays the boot -- see system/README.md.
NETUP=/usr/bin/neytra-netup
if [ -x "$NETUP" ]; then
    "$NETUP" &
    $LOG info init "network bring-up started in background (neytra-netup)"
fi

$LOG info init "boot complete, handing off to shell"
/bin/sh
